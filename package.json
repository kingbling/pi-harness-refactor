{
  "name": "pi-bigrefactor",
  "version": "0.1.0",
  "description": "Ledger-driven autonomous legacy migration: a Pi package (extension + br CLI)",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "br": "./bin/br.js"
  },
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ]
  },
  "scripts": {
    "br": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picocolors": "^1.1.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
